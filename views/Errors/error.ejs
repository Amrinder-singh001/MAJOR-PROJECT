
<% layout("/layouts/boilerplate") %>

<style>
    .error-wrapper {
        min-height: 65vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        background: radial-gradient(
            circle at top left,
            #fff1f2 0%,
            #f8f9fc 55%,
            #fdf2f8 100%
        );
    }

    .error-card {
        width: 100%;
        max-width: 720px;
        background: #ffffff;
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        border: 1px solid #f1dfe2;
        box-shadow: 0 15px 45px rgba(40, 40, 60, 0.08);
        animation: appear 0.4s ease-out;
    }

    .error-icon {
        width: 85px;
        height: 85px;
        margin: 0 auto 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0f1;
        color: #fe424d;
        font-size: 42px;
    }

    .error-code {
        color: #fe424d;
        font-size: 58px;
        font-weight: 750;
        line-height: 1.2;
        margin-bottom: 10px;
        letter-spacing: -2px;
    }

    .error-title {
        color: #222222;
        font-size: 25px;
        font-weight: 650;
        margin-bottom: 12px;
    }

    .error-message {
        color: #777777;
        font-size: 15px;
        line-height: 1.8;
        overflow-wrap: anywhere;
        margin: 0 auto 28px;
        max-width: 560px;
    }

    .error-divider {
        width: 65px;
        height: 4px;
        background: #fe424d;
        border-radius: 10px;
        margin: 20px auto;
    }

    .error-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .error-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 23px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.25s ease;
    }

    .error-btn-primary {
        background: #fe424d;
        color: white;
        border: 1px solid #fe424d;
    }

    .error-btn-primary:hover {
        background: #e93642;
        border-color: #e93642;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(254, 66, 77, 0.22);
    }

    .error-btn-secondary {
        background: white;
        color: #333333;
        border: 1px solid #e2e2e2;
    }

    .error-btn-secondary:hover {
        background: #f8f8f8;
        color: #fe424d;
        border-color: #fe424d;
        transform: translateY(-2px);
    }

    .error-help {
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid #eeeeee;
        color: #999999;
        font-size: 12px;
    }

    @keyframes appear {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 576px) {
        .error-card {
            padding: 30px 20px;
        }

        .error-code {
            font-size: 48px;
        }

        .error-title {
            font-size: 21px;
        }

        .error-wrapper {
            padding: 30px 14px;
        }
    }
</style>

<div class="error-wrapper">
    <div class="error-card">

        <!-- Error Icon -->
        <div class="error-icon">
            <i class="fa-solid fa-circle-exclamation"></i>
        </div>

        <!-- Status Code -->
        <h1 class="error-code">
            <%= err.statusCode || 500 %>
        </h1>

        <!-- Error Heading -->
        <h2 class="error-title">
            Oops! Something went wrong.
        </h2>

        <div class="error-divider"></div>

        <!-- Error Message -->
        <p class="error-message">
            <%= err.message || "An unexpected error occurred. Please try again later." %>
        </p>

        <!-- Action Buttons -->
        <div class="error-actions">

            <a href="/listings" class="error-btn error-btn-primary">
                <i class="fa-solid fa-house"></i>
                Back to Listings
            </a>

            <a href="javascript:history.back()"
               class="error-btn error-btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Go Back
            </a>

        </div>

        <!-- Footer Message -->
        <div class="error-help">
            <a href="/listings"><i style="font-size: 1rem;" class="fa-duotone fa-solid fa-compass fa-spin-snap-8"></i></a>
            Don't worry, your next adventure is waiting!
            <br>
            <strong>WanderLust</strong> — Explore the world, one stay at a time.
        </div>

    </div>
</div>