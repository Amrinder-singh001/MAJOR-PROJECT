<% if(successMsg && successMsg.length){ %>
    <div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
        <i class="fa-solid fa-thumbs-up fa-jello"></i>&nbsp;&nbsp;
            <%= successMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>    
<% } %>

<!-- if any error occured that's why -->
<% if(errorMsg && errorMsg.length){ %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">
        <i class="fa-solid fa-thumbs-down fa-beat-fade"></i>&nbsp;&nbsp;
            <%= errorMsg %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>    
<% } %>