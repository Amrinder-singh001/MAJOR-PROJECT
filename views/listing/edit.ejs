
<% layout("/layouts/boilerplate") %>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">

            <div class="form-container">
                <h2>Edit your List</h2>

                <form method="post"
                      action="/listing/<%= listId._id %>?_method=PUT"
                      class="needs-validation"
                      novalidate>

                    <!-- Listing Title -->
                    <div class="form-group">
                        <label for="title">Want to edit your title ?</label>
                        <input type="text"
                               id="title"
                               name="title"
                               class="form-control"
                               value="<%= listId.title %>"
                               required>
                        <div class="valid-feedback">Title updated!!</div>
                        <div class="invalid-feedback">Title required..</div>
                    </div>

                    <!-- Listing Description -->
                    <div class="form-group">
                        <label for="description">What's your new description ?</label>
                        <textarea id="description"
                                name="description"
                                class="form-control"
                                rows="4"
                                required><%= listId.description %></textarea>
                        <div class="valid-feedback">Description updated!!</div>          
                        <div class="invalid-feedback">Description is required..</div>
                    </div>

                    <!-- Image URL -->
                    <div class="form-group">
                        <label for="image">Updated image link..</label>
                        <input type="url"
                               id="image"
                               name="image"
                               class="form-control"
                               value="<%= listId.image %>"
                               required>
                        <div class="valid-feedback">Image link updated!!</div>
                        <div class="invalid-feedback">Image link reqired....</div>
                    </div>

                    <!-- Price and Country in Same Row -->
                    <div class="row">

                        <!-- Price -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="price">What's your new price value ?</label>
                                <input type="number"
                                       id="price"
                                       name="price"
                                       class="form-control"
                                       min="0"
                                       value="<%= listId.price %>"
                                       required>
                                <div class="valid-feedback">Price updated!!</div>  
                                <div class="invalid-feedback">Price is compulsory..</div>    
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="country">New country name</label>
                                <input type="text"
                                       id="country"
                                       name="country"
                                       class="form-control"
                                       value="<%= listId.country %>"
                                       required>
                                <div class="valid-feedback">Country updated!!</div>
                                <div class="invalid-feedback">Country name required..</div>
                            </div>
                        </div>

                    </div>

                    <!-- Location -->
                    <div class="form-group">
                        <label for="location">New location ?</label>
                        <input type="text"
                               id="location"
                               name="location"
                               class="form-control"
                               value="<%= listId.location %>"
                               required>
                        <div class="valid-feedback">Location updated!!</div>
                        <div class="invalid-feedback">Location required..</div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="submit-btn">
                        Edit your list
                    </button>

                </form>
            </div>

        </div>
    </div>
</div>
