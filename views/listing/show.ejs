
<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

  <!-- ================= Listing Header ================= -->

  <div class="row justify-content-center">
    <div class="col-lg-8">

      <h2 class="mb-4 fw-bold text-dark">
        <%= listId.title %>
      </h2>

    </div>
  </div>


  <!-- ================= Listing Details ================= -->

  <div class="row justify-content-center">
    <div class="col-lg-8">

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">

        <!-- Listing Image -->

        <img
          src="<%= listId.image %>"
          class="card-img-top show-img object-fit-cover"
          style="height: 400px;"
          alt="Listing Image"
        >

        <div class="card-body p-4">

          <!-- Price and Location -->

          <div class="d-flex justify-content-between align-items-center mb-3">

            <h4 class="text-primary fw-semibold mb-0">
              &#x20B9;<%= listId.price.toLocaleString("en-in") %>
              <span class="text-muted fs-6">/ night</span>
            </h4>

            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
              <%= listId.location %>, <%= listId.country %>
            </span>

          </div>

          <hr class="text-muted my-3">


          <!-- ================= Description ================= -->

          <h5 class="fw-bold mb-2">
            About this place
          </h5>

          <p class="card-text text-secondary lh-lg mb-4">
            <%= listId.description %>
          </p>


          <!-- ================= Action Buttons ================= -->

          <div class="d-flex gap-3 align-items-center mt-4">

            <a
              href="/listings/<%= listId._id %>/edit"
              class="btn btn-dark px-4 py-2 rounded-pill fw-medium"
            >
              Edit this listing
            </a>

            <form
              method="POST"
              action="/listings/<%= listId._id %>?_method=DELETE"
              class="mb-0"
            >
              <button
                type="submit"
                class="btn btn-outline-danger px-4 py-2 rounded-pill fw-medium"
              >
                Delete list
              </button>
            </form>

          </div>


          <!-- ================= Leave a Review ================= -->

          <div class="mt-4">

            <hr class="text-muted my-3">

            <h4 class="mb-4">
              Leave a review
            </h4>

            <form
              action="/listings/<%= listId._id %>/reviews"
              method="POST"
              novalidate
              class="needs-validation"
            >

              <!-- Rating -->

              <div class="mb-3">

                <label class="form-label mb-2" for="rating">
                  Rating
                </label>

                <input
                  class="form-range"
                  type="range"
                  id="rating"
                  name="rating"
                  min="1"
                  max="5"
                >

              </div>


              <!-- Comment -->

              <div class="mb-3">

                <label class="form-label mb-2" for="comment">
                  Comments
                </label>

                <textarea
                  style="border-radius: 20px;"
                  class="form-control"
                  id="comment"
                  name="comment"
                  rows="5"
                  cols="30"
                  required
                ></textarea>

                <div class="invalid-feedback">
                  Tell something about your experience.
                </div>

              </div>


              <!-- Submit Button -->

              <button
                type="submit"
                class="btn btn-outline-primary px-4 py-2 rounded-pill fw-medium"
              >
                Submit
              </button>

            </form>

          </div>


          <!-- ================= Guest Reviews ================= -->

          <hr class="my-4">

          <h4 class="mb-2">
            Guest Reviews
          </h4>

          <p class="text-muted mb-4">
            <%= listId.reviews.length %> Reviews
          </p>


          <% if (listId.reviews.length === 0) { %>

            <p class="text-muted">
              No reviews yet. Be the first to leave a review.
            </p>

          <% } else { %>


            <!-- Reviews Grid -->

            <div class="review-grid">

              <% listId.reviews.forEach(review => { %>

                <!-- Individual Review Card -->

                <div class="card review-card border rounded-4 shadow-sm">

                  <!-- Rating and Verification -->

                  <div class="review-rating">

                    <span>⭐</span>

                    <strong>
                      <%= review.rating %>/5
                    </strong>

                    <span class="text-success verified-text">
                      Verified Review
                    </span>

                  </div>


                  <!-- Review Comment -->

                  <p class="review-comment">
                    <%= review.comment %>
                  </p>


                  <!-- Review Footer -->

                  <div class="review-footer">

                    <!-- Delete Review -->

                    <form
                      action="/listings/<%= listId._id %>/reviews/<%= review._id %>?_method=DELETE"
                      method="POST"
                      class="mb-3"
                    >

                      <button
                        type="submit"
                        class="btn btn-outline-dark rounded-pill fw-medium"
                      >
                        Delete
                      </button>

                    </form>


                    <hr>

                    <!-- Review Date -->

                    <small class="text-muted">

                      Reviewed on

                      <%= review.created_at
                        ? new Date(review.created_at).toLocaleDateString('en-IN')
                        : 'Date unavailable'
                      %>

                    </small>

                  </div>

                </div>

              <% }) %>

            </div>

          <% } %>

        </div>
      </div>

    </div>
  </div>

</div>
