<% layout("/layouts/boilerplate") %>
<div class="offset-2 form-container">
    <h2>Create New Listing</h2>
    <form method="POST" action="/listings" class="needs-validation">
        
        <!-- Listing Title -->
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" placeholder="e.g. Cozy Beachfront Villa" required>
        </div>

        <!-- Listing Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" placeholder="Describe the place, amenities, and surroundings..." required></textarea>
        </div>
 
        <!-- Image URL -->
        <div class="form-group">
            <label for="image">Image Link</label>
            <input type="url" id="image" name="image" placeholder="https://example.com/image.jpg">
        </div>

        <!-- Price & Country (Ek Hi Line Mein) -->
        <div class="row">
            <div class="form-group">
                <label for="price">Your's price (per night)</label>
                <input type="number" id="price" name="price" placeholder="e.g. 1200" required>
            </div>

            <div class="mb-3 form-group">
                <label for="country">Country</label>
                <input type="text" id="country" name="country" placeholder="e.g. India" required>
            </div>
        </div>

        <!-- Location -->
        <div class="form-group">
            <label for="location">Location / City</label>
            <input type="text" id="location" name="location" placeholder="e.g. Goa, Calangute" required>
        </div>

        <br>
        <!-- Submit Button -->
        <button type="submit" class="submit-btn">Create Listing</button>

        <br>
    </form>
</div>