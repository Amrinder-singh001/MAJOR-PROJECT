<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center">
<div class="form-container" style="width: 600px;">
    <h2>Create New Listing</h2>
    <form method="POST" action="/listings" novalidate class="needs-validation">
        
        <!-- Listing Title -->
        <div class="form-group">
            <label for="title">Title</label>
            <input class="form-control" type="text" id="title" name="title" placeholder="e.g. Cozy Beachfront Villa" required>
            <div class="valid-feedback">Title looks good..</div>
            <div class="invalid-feedback">
                Title is required..
            </div>
        </div>

        <!-- Listing Description -->
        <div class="form-group">
            <label for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe the place, amenities, and surroundings..." required></textarea>
            <div class="valid-feedback">Description looks astuethics..</div>
            <div class="invalid-feedback">Enter short description..</div>
        </div>
 
        <!-- Image URL -->
        <div class="form-group">
            <label for="image">Image Link</label>
            <input class="form-control" type="url" id="image" name="image" placeholder="https://example.com/image.jpg">
            <div class="valid-feedback">Insert image link..</div>
            <div class="invalid-feedback">Enter valid image URL..</div>
        </div>

        <!-- Price & Country (Ek Hi Line Mein) -->
        <div class="row">
            <div class="form-group">
                <label for="price">Your's price (per night)</label>
                <input class="form-control" id="price" name="price" placeholder="e.g. 1200" required>
                <div class="valid-feedback">Price added..</div>
                <div class="invalid-feedback">price is compulsory..</div>
            </div>

            <div class="mb-3 form-group">
                <label for="country">Country</label>
                <input class="form-control" type="text" id="country" name="country" placeholder="e.g. India" required>
                <div class="valid-feedback">Proud of our country..</div>
                <div class="invalid-feedback">Country is required..</div>
            </div>
        </div>

        <!-- Location -->
        <div class="form-group">
            <label for="location">Location / City</label>
            <input class="form-control" type="text" id="location" name="location" placeholder="e.g. Goa, Calangute" required>
            <div class="valid-feedback">Location added..</div>
            <div class="invalid-feedback">Enter valid location..</div>
        </div>

        <br>
        <!-- Submit Button -->
        <button type="submit" class="submit-btn">Create Listing</button>

        <br>
    </form>
 </div>
</div>