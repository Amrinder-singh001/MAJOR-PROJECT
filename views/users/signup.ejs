<% layout("/layouts/boilerplate") %>

<div class="container d-flex justify-content-center py-5">

    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 430px;">

        <div class="card-body">
            <div class="d-flex justify-content-left align-items-center gap-2 mb-2">
                <i class="fa-solid fa-compass fa-buzz"></i>
                <h2 class="text-center fw-bold mb-2">&nbsp; Join Wanderlust</h2>
            </div>
            <p class="text-center text-muted mb-4">
                Create your account and start exploring!
            </p>

            <form action="/signup" method="POST" class="needs-validation" novalidate>

                <!-- Username -->
                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold">
                        Username
                    </label>
                    <input style="border-radius: 12px; height: 43px;"
                        type="text"
                        class="form-control form-control-md"
                        id="username"
                        name="username"
                        placeholder="Enter your username"
                        required
                    >
                    <div class="valid-feedback">Username available..</div>
                    <div class="invalid-feedback">Enter valid username</div>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">
                        Email Address
                    </label>
                    <input style="border-radius: 12px; height: 43px;"
                        type="email"
                        class="form-control form-control-md"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >
                    <div class="valid-feedback">Email available</div>
                    <div class="invalid-feedback">Enter valid email</div>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">
                        Password
                    </label>
                    <input style="border-radius: 12px; height: 43px;"
                        type="password"
                        class="form-control form-control-md"
                        id="password"
                        name="password"
                        placeholder="Create a password"
                        required
                    >
                    <div class="valid-feedback">password looks strong..</div>
                    <div class="invalid-feedback">Enter strong password</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3">
                    Create Account
                </button>

            </form>

            <p class="text-center mt-4 mb-0 text-muted">
                Already have an account?
                <a href="/login" class="text-decoration-none fw-semibold">
                    Login
                </a>
            </p>

        </div>
    </div>

</div>
